    },
    "daily_loss_limit": {
      "trigger": "equity <= start_of_day_equity - 200.0",
      "reason": "DAILY_LOSS_LIMIT",
      "action": "flatten_once_and_halt_until_next_utc_day",
      "latch": "latched_until_next_utc_day",
      "rationale": "Cortar drawdown diario de inmediato y apagar el runner"
    },
    "max_risk_per_order": {
      "formula": "|entry_price - stop_price| * dollars_per_point * size",
      "threshold_usd": 200.0,
      "adaptation": "if risk > 200 and risk_at_1_micro <= 200 -> reduce size to 1 micro",
      "veto": "if risk_at_1_micro > 200 -> reject order with MAX_RISK_PER_ORDER",
      "rationale": "Garantizar que ninguna orden individual exponga más de $200"
    },
    "accumulated_loss_drawdown": {
      "trigger": "equity <= reference_balance - 1000.0",
      "reason": "DRAWDOWN_BUFFER_TOO_LOW",
      "action": "flatten_and_total_shutdown",
      "latch": "permanent_shutdown",
      "rationale": "Disciplina de preservación de cuenta de práctica"
    },
    "anti_overtrading": {
      "trigger": "trades_applied >= 6",
      "reason": "MAX_TRADES_REACHED",
      "action": "veto_subsequent_orders_for_the_day"
    }
