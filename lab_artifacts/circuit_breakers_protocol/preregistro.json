  "declared_behaviors": {
    "daily_profit_target": {
      "trigger": "equity >= start_of_day_equity + 500.0",
      "reason": "DAILY_PROFIT_TARGET_REACHED",
      "action": "flatten_once_if_open_and_halt_for_today",
