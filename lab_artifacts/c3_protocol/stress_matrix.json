      },
      {
        "id": "cost_plus_50pct",
        "definition": "commission and applicable por_tramo slippage multiplied by 1.50",
        "justification": "severe cost-estimation error"
      },
      {
        "id": "all_legs_adverse_slippage",
        "definition": "0.25 points adverse on the complete entry quantity and complete exit quantity, including LIMIT and TP, plus base commission",
        "justification": "pessimistic execution bound"
      },
      {
        "id": "limit_gap_no_fill",
        "definition": "for LIMIT strategies discard a trade when its fill-bar open is strictly through the limit in the favorable direction (long open<limit; short open>limit); market-entry strategies equal base",
        "justification": "conservative no-fill treatment for gaps through resting limits"
      },
      {
        "id": "gap_stop_next_open",
        "definition": "stop exits fill at the exit-bar open when it is worse than the stop, else at stop minus/plus base adverse slippage; report gap count; this is expected to match the existing executor's gap rule",
        "justification": "funded-account tail loss from price gaps"
      },
      {
        "id": "degraded_heavy_loss_cbb",
        "definition": "chronological R transformed as r-0.10 for r>=0 and 1.25*r-0.10 for r<0; deterministic circular block bootstrap, block_length=40 trades, B=2000, master_seed=20260914",
        "justification": "longer dependence blocks, degraded expectancy, and 25% heavier losses"
      },
      {
        "id": "half_frequency",
        "definition": "within each fold keep chronological trade indices 0,2,4,... before concatenation",
        "justification": "fixed non-outcome-selected loss of one in every two setups"
      }
    ],
    "method_note": "Fixed post-execution counterfactual repricing/filtering; signals and executor are unchanged.",
